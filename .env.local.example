# ─────────────────────────────────────────────────────────────────────
# GOD DUNGEON — Environment Variables
# Copy this to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────────────

# Required — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── AI Backend per Agent ─────────────────────────────────────────────
# Each agent can be switched to Ollama (local) or OpenAI independently.
# Edit src/config/agents.ts to change backend/model per agent.
#
# To use Ollama (free, local):
#   1. Install Ollama: https://ollama.ai
#   2. Run: ollama pull llama3
#   3. In agents.ts: backend: 'ollama', model: 'llama3'
#   No API key needed. Ollama runs at http://localhost:11434 by default.
#
# To use OpenAI:
#   In agents.ts: backend: 'openai', model: 'gpt-4o'
OPENAI_API_KEY=sk-...

# ─── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=God Dungeon

# ─── Database ─────────────────────────────────────────────────────────
# SQLite DB is created automatically at dungeon.db in project root.
# No config needed. Seed data is inserted on first run.
